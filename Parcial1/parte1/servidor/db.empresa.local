; BIND reverse data file for empty rfc1918 zone
;
; DO NOT EDIT THIS FILE - it is used for multiple zones.
; Instead, copy it, edit named.conf, and use that copy.
;
$TTL 3600
@   IN  SOA maestro.empresa.local. admin.empresa.local. (
        2026090704 ; Serial AAAAMMDDNN
        3600       ; Refresh
        900        ; Retry
        604800     ; Expire
        3600 )     ; Minimum

        IN  NS      maestro.empresa.local.
        IN  NS      esclavo.empresa.local.
        IN  MX  10  mail.empresa.local.

maestro IN  A       192.168.50.3
maestro IN  AAAA    fd00:50::3
esclavo IN  A       192.168.50.2
esclavo IN  AAAA    fd00:50::2
ns1     IN  CNAME   maestro
ns2     IN  CNAME   esclavo
www     IN  A       192.168.50.2
www     IN  AAAA    fd00:50::2
mail    IN  A       192.168.50.99
mail    IN  AAAA    fd00:50::2
ftp     IN  CNAME   www
parcial IN  A       192.168.50.2
parcial IN  AAAA    fd00:50::2
